# SLB – Sonderabfall Logistik Bayern
# Redirects der alten WordPress-URLs auf die neue One-Page-Struktur
# Apache 2.4+ / mod_rewrite

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Trailing-Slash-Varianten zuerst entfernen (außer Verzeichnis-Index)
  # Alte Legal-URLs
  RewriteRule ^datenschutzerklaerung/?$ /datenschutz [R=301,L]
  RewriteRule ^datenschutz-erklaerung/?$ /datenschutz [R=301,L]
  RewriteRule ^privacy/?$              /datenschutz [R=301,L]
  RewriteRule ^legal-notice/?$         /impressum   [R=301,L]
  RewriteRule ^imprint/?$              /impressum   [R=301,L]

  # Alte Section-URLs der WP-Seite -> One-Page Anker
  RewriteRule ^leistungen/?$        /#leistungen [R=301,L,NE]
  RewriteRule ^services/?$          /#leistungen [R=301,L,NE]
  RewriteRule ^abfallarten/?$       /#leistungen [R=301,L,NE]
  RewriteRule ^entsorgung/?$        /#leistungen [R=301,L,NE]

  RewriteRule ^uns/?$               /#uns        [R=301,L,NE]
  RewriteRule ^ueber-uns/?$         /#uns        [R=301,L,NE]
  RewriteRule ^ueber/?$             /#uns        [R=301,L,NE]
  RewriteRule ^about/?$             /#uns        [R=301,L,NE]
  RewriteRule ^unternehmen/?$       /#uns        [R=301,L,NE]

  RewriteRule ^fahrzeuge/?$         /#fahrzeuge  [R=301,L,NE]
  RewriteRule ^fuhrpark/?$          /#fahrzeuge  [R=301,L,NE]
  RewriteRule ^vehicles/?$          /#fahrzeuge  [R=301,L,NE]
  RewriteRule ^lkw/?$               /#fahrzeuge  [R=301,L,NE]

  RewriteRule ^karriere/?$          /#karriere   [R=301,L,NE]
  RewriteRule ^jobs/?$              /#karriere   [R=301,L,NE]
  RewriteRule ^stellenangebote/?$   /#karriere   [R=301,L,NE]
  RewriteRule ^career/?$            /#karriere   [R=301,L,NE]

  RewriteRule ^kontakt/?$           /#kontakt    [R=301,L,NE]
  RewriteRule ^contact/?$           /#kontakt    [R=301,L,NE]
  RewriteRule ^anfahrt/?$           /#kontakt    [R=301,L,NE]
  RewriteRule ^standort/?$          /#kontakt    [R=301,L,NE]

  # WordPress-Standard-Pfade ins Leere -> auf Startseite umleiten
  RewriteRule ^wp-admin/?(.*)$      /            [R=301,L]
  RewriteRule ^wp-login\.php$       /            [R=301,L]
  RewriteRule ^wp-content/(.*)$     /            [R=301,L]
  RewriteRule ^feed/?$              /            [R=301,L]
  RewriteRule ^author/(.*)$         /            [R=301,L]
  RewriteRule ^category/(.*)$       /            [R=301,L]
  RewriteRule ^tag/(.*)$            /            [R=301,L]

  # 404 -> Startseite (nur für nicht existierende Routen)
  ErrorDocument 404 /
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Caching für statische Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg     "access plus 1 year"
  ExpiresByType image/png      "access plus 1 year"
  ExpiresByType image/svg+xml  "access plus 1 year"
  ExpiresByType image/webp     "access plus 1 year"
  ExpiresByType font/woff2     "access plus 1 year"
  ExpiresByType text/css       "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html      "access plus 1 hour"
</IfModule>

# Kompression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
