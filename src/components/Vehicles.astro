---
const B = import.meta.env.BASE_URL;
const vehicles = [
  {
    n: "01",
    title: "Saug-/Drucktankzüge",
    desc: "Flüssigkeitstransport mit und ohne Ausschubkolben. Volumen 24–27 m³ – ideal für pumpfähige Sonderabfälle.",
    image: `${B}images/slb-saugdrucktankzug-edelstahl-alpen.jpeg`,
    spec: "24 – 27 m³",
  },
  {
    n: "02",
    title: "Muldenkipper mit Anhänger",
    desc: "Transport von bis zu 3 Containern à 7–15 m³. Flexibel einsetzbar für unterschiedlichste Schüttgüter.",
    image: `${B}images/slb-absetzkipper-orange-container.jpeg`,
    spec: "3 × 7–15 m³",
  },
  {
    n: "03",
    title: "Containerfahrzeuge mit Anhänger",
    desc: "Transport von Abrollcontainern – flüssigkeitsdicht, mit Deckel oder Plane. 37–40 m³ Volumen.",
    image: `${B}images/slb-fuhrpark-man-trucks.jpeg`,
    spec: "37 – 40 m³",
  },
  {
    n: "04",
    title: "Planensattel- & Wechselbrückenzüge",
    desc: "Stückgut-Transport mit eigenen Wechsel- und Spezialbrücken (z. B. Kühlcontainer).",
    image: `${B}images/slb-planensattelzug-weiss-01.jpeg`,
    spec: "Stückgut",
  },
];
---

<section id="fahrzeuge" class="relative py-24 lg:py-32 bg-ink text-white overflow-hidden">
  <div class="absolute -inset-y-32 inset-x-0 opacity-[0.08] pointer-events-none" data-parallax-y="0.45">
    <img src={`${B}images/slb-saugdrucktankzuege-werksgelaende.jpeg`} alt="" class="w-full h-full object-cover" />
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-ink via-ink/95 to-ink"></div>

  <div class="relative mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <div class="reveal text-xs font-bold tracking-[0.3em] uppercase text-brand mb-4">
        Fuhrpark
      </div>
      <h2 class="reveal reveal-delay-1 text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight">
        Vier Fahrzeug­kategorien für<br/>jeden Einsatz
      </h2>
      <p class="reveal reveal-delay-2 mt-6 text-lg text-white/85 leading-relaxed">
        Modernste Spezialfahrzeuge – ausgelegt auf Sicherheit, Effizienz und
        die Anforderungen des Gefahrgut-Transports.
      </p>
    </div>

    <div class="mt-16 grid md:grid-cols-2 gap-6 lg:gap-8" style="perspective: 1400px;">
      {vehicles.map((v) => (
        <article class="vcard reveal group relative overflow-hidden rounded-3xl bg-white text-ink border border-white/10 transition-shadow duration-500">
          <div class="vcard-inner">
            <div class="vcard-img-wrap relative aspect-[16/10] overflow-hidden">
              <img
                src={v.image}
                alt={v.title}
                loading="lazy"
                class="vcard-img w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/45 via-transparent to-transparent pointer-events-none"></div>
              <div class="vcard-spot pointer-events-none absolute inset-0"></div>
            </div>

            <div class="absolute top-3 left-4 sm:top-5 sm:left-5 text-white font-bold text-sm tracking-widest num-badge drop-shadow-lg">
              {v.n}
            </div>
            <div class="vcard-spec absolute top-3 right-3 sm:top-5 sm:right-5 inline-flex items-center rounded-full bg-brand text-ink px-2.5 py-1 text-[11px] sm:text-xs font-bold shadow-lg whitespace-nowrap">
              {v.spec}
            </div>

            <div class="p-7 lg:p-8">
              <h3 class="text-2xl font-bold text-ink mb-3 group-hover:text-brand-dark transition-colors">
                {v.title}
              </h3>
              <p class="text-ink-soft leading-relaxed">{v.desc}</p>
            </div>

            <span class="vcard-shine pointer-events-none absolute inset-0"></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .vcard {
    --rx: 0deg;
    --ry: 0deg;
    --mx: 50%;
    --my: 50%;
    transform-style: preserve-3d;
    transition: transform 0.5s cubic-bezier(.2,.8,.2,1), box-shadow 0.5s;
  }
  .vcard.is-tilting {
    transform: perspective(1400px) rotateX(var(--rx)) rotateY(var(--ry)) translateZ(0);
    transition: transform 0.18s linear, box-shadow 0.4s;
    box-shadow: 0 18px 40px -25px rgba(148, 193, 32, 0.18);
  }

  .vcard-inner {
    position: relative;
    transform: translateZ(0);
  }

  .vcard-img {
    transition: transform 1s cubic-bezier(.2,.7,.2,1);
    will-change: transform;
  }
  .vcard.is-tilting .vcard-img,
  .vcard:hover .vcard-img { transform: scale(1.02); }

  /* Spotlight folgt Cursor */
  .vcard-spot {
    background: radial-gradient(
      circle 180px at var(--mx) var(--my),
      rgba(148, 193, 32, 0.12) 0%,
      rgba(148, 193, 32, 0.04) 35%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.5s;
    mix-blend-mode: screen;
  }
  .vcard:hover .vcard-spot,
  .vcard.is-tilting .vcard-spot { opacity: 1; }

  /* Glanz-Sweep diagonal — sehr dezent */
  .vcard-shine {
    background: linear-gradient(115deg,
      transparent 44%,
      rgba(255,255,255,0.12) 50%,
      transparent 56%);
    transform: translateX(-110%);
    opacity: 0;
  }
  .vcard:hover .vcard-shine {
    opacity: 1;
    animation: vshine 1.4s cubic-bezier(.4,0,.2,1) forwards;
  }
  @keyframes vshine {
    from { transform: translateX(-110%); }
    to   { transform: translateX(110%); }
  }

  /* Spec-Pill ganz leicht */
  .vcard-spec { transition: transform 0.4s cubic-bezier(.2,.8,.2,1); }
  .vcard:hover .vcard-spec { transform: translateY(-1px); }

  @media (prefers-reduced-motion: reduce) {
    .vcard, .vcard-img, .vcard-shine, .vcard-spec { animation: none !important; transition: none !important; transform: none !important; }
  }
  @media (hover: none) {
    .vcard.is-tilting { transform: none; }
    .vcard-spot, .vcard-shine { display: none; }
  }
</style>

<script is:inline>
  (function () {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(hover: none)").matches) return;
    const cards = document.querySelectorAll(".vcard");
    const MAX = 1.5; // max Tilt-Grad — bewusst sehr dezent
    cards.forEach((card) => {
      let raf = 0;
      function onMove(e) {
        const r = card.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        const px = x / r.width;   // 0..1
        const py = y / r.height;
        const ry = (px - 0.5) *  MAX * 2;
        const rx = (py - 0.5) * -MAX * 2;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          card.style.setProperty("--rx", rx.toFixed(2) + "deg");
          card.style.setProperty("--ry", ry.toFixed(2) + "deg");
          card.style.setProperty("--mx", x.toFixed(0) + "px");
          card.style.setProperty("--my", y.toFixed(0) + "px");
        });
      }
      card.addEventListener("mouseenter", () => card.classList.add("is-tilting"));
      card.addEventListener("mousemove", onMove);
      card.addEventListener("mouseleave", () => {
        card.classList.remove("is-tilting");
        card.style.setProperty("--rx", "0deg");
        card.style.setProperty("--ry", "0deg");
      });
    });
  })();
</script>
