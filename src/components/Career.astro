---
const B = import.meta.env.BASE_URL;
---

<section id="karriere" class="relative py-24 lg:py-32 overflow-hidden">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid lg:grid-cols-5 gap-12 items-center">
      <div class="lg:col-span-3">
        <div class="reveal text-xs font-bold tracking-[0.3em] uppercase text-brand-dark mb-4">
          Karriere
        </div>
        <h2 class="reveal reveal-delay-1 text-3xl sm:text-4xl lg:text-5xl font-bold text-ink leading-tight">
          Werden Sie Teil unseres<br/><span class="text-brand-dark">SLB-Teams</span>.
        </h2>
        <p class="reveal reveal-delay-2 mt-6 text-lg text-ink-soft leading-relaxed max-w-xl">
          Wir suchen zuverlässige Persönlichkeiten, die mit uns Verantwortung
          für Umwelt und Sicherheit übernehmen.
        </p>

        <div class="reveal reveal-delay-3 mt-10 bg-white border border-black/5 rounded-3xl p-8 lg:p-10 shadow-lg">
          <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
            <div>
              <div class="text-xs font-semibold tracking-widest uppercase text-brand-dark mb-2">Offene Stelle</div>
              <h3 class="text-2xl lg:text-3xl font-bold text-ink">LKW-Fahrer (m/w/d)</h3>
            </div>
            <span class="rounded-full bg-brand text-ink px-4 py-1.5 text-xs font-bold">Vollzeit</span>
          </div>

          <ul class="space-y-3 text-ink-soft mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 text-brand-dark shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Führerschein Klasse CE
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 text-brand-dark shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Zuverlässige und sorgfältige Arbeitsweise
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 text-brand-dark shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              ADR-Schein wünschenswert (Schulung möglich)
            </li>
          </ul>

          <div class="border-t border-black/5 pt-6">
            <div class="text-sm text-ink-soft mb-3">Bewerbungen bitte an:</div>
            <address class="not-italic text-ink leading-relaxed">
              SLB Sonderabfall Logistik Bayern GmbH<br/>
              Carl-Benz-Strasse 5, 85053 Ingolstadt
            </address>
            <a
              href="mailto:info@slb-logistik.de?subject=Bewerbung%20LKW-Fahrer"
              class="mt-6 inline-flex items-center gap-2 rounded-full bg-ink text-white px-6 py-3 text-sm font-semibold hover:bg-brand-dark transition-colors"
            >
              Jetzt bewerben
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="lg:col-span-2 reveal reveal-delay-2">
        <div class="career-stage relative" style="perspective: 1200px;">
          <figure class="career-img relative aspect-[3/4] rounded-3xl shadow-2xl">
            <img
              src={`${B}images/slb-6.jpg`}
              alt="SLB Fahrer"
              class="career-photo absolute inset-0 w-full h-[125%] -top-[12%] object-cover"
              data-parallax-y="0.35"
            />
            <span class="career-wipe"></span>
          </figure>
          <div class="career-badge absolute -bottom-4 left-2 sm:-bottom-6 sm:-left-6 bg-brand-dark text-white rounded-2xl p-4 sm:p-5 shadow-xl max-w-[200px] z-10">
            <div class="text-xs uppercase tracking-widest text-brand mb-1">Wir sind</div>
            <div class="font-bold leading-snug">Ein verlässliches Team mit Tradition.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .career-stage { transform-style: preserve-3d; }
  .career-img {
    clip-path: inset(0 round 1.5rem);
    transition: transform 0.7s cubic-bezier(.2,.8,.2,1), box-shadow 0.7s;
    will-change: transform;
    backface-visibility: hidden;
    isolation: isolate;
  }
  .career-photo { transition: transform 0.9s cubic-bezier(.2,.7,.2,1); }
  .career-stage:hover .career-img {
    transform: rotateY(-5deg) rotateX(3deg) translateZ(20px);
    box-shadow: 0 35px 60px -25px rgba(15,125,64,0.5);
  }
  .career-stage:hover .career-photo { transform: scale(1.06); }

  .career-wipe {
    position: absolute; inset: 0;
    background: linear-gradient(115deg,
      transparent 42%,
      rgba(255,255,255,0.18) 49%,
      rgba(148,193,32,0.55) 50%,
      rgba(255,255,255,0.18) 51%,
      transparent 58%);
    transform: translateX(-110%);
    pointer-events: none;
    opacity: 0;
  }
  .career-img:hover .career-wipe {
    opacity: 1;
    animation: careerWipe 0.9s cubic-bezier(.4,0,.2,1) forwards;
  }
  @keyframes careerWipe {
    from { transform: translateX(-110%); }
    to   { transform: translateX(110%); }
  }

  .career-badge {
    animation: careerFloat 6s ease-in-out infinite;
    transform-origin: center;
  }
  @keyframes careerFloat {
    0%,100% { transform: translateY(0) rotate(2deg); }
    50%     { transform: translateY(-6px) rotate(-2deg); }
  }
  .career-stage:hover .career-badge {
    transform: translateY(-10px) rotate(4deg) scale(1.05);
    transition: transform 0.5s cubic-bezier(.2,.8,.2,1);
    animation: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .career-img, .career-photo, .career-badge, .career-wipe { animation: none !important; transition: none !important; }
  }
</style>
