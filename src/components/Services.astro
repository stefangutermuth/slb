---
const wasteGroups = [
  {
    title: "Öle & Schmierstoffe",
    icon: "drop",
    items: [
      "Altöle",
      "Ölfilter",
      "Ölschlämme",
      "Ölabscheiderinhalte",
      "Ölhaltige Betriebsmittel",
      "Bremsflüssigkeiten",
      "Kühlerfrostschutz",
    ],
  },
  {
    title: "Chemie & Lösemittel",
    icon: "flask",
    items: [
      "Altchemikalien",
      "Farben & Lacke",
      "Lösemittelgemische",
      "Spritzkabinenabwässer",
      "Spülflüssigkeiten",
      "Entfettungsbäder",
    ],
  },
  {
    title: "Industrieabfälle",
    icon: "factory",
    items: [
      "Bearbeitungsemulsionen",
      "Fettabscheider",
      "Flüssigkeiten & Schlämme",
      "Schüttgüter",
    ],
  },
  {
    title: "Gebinde & Container",
    icon: "box",
    items: [
      "Verpackungen & Großpackmittel (IBC)",
      "Gebinde",
      "Paletten",
      "ISO-Container 20/30/40 ft",
    ],
  },
];

const features = [
  {
    title: "Sicherheit zuerst",
    desc: "Geschultes Personal, ADR-zertifiziert. Strenge Standards bei jedem Transport.",
    icon: "shield",
  },
  {
    title: "Umweltgerecht",
    desc: "Direkter Weg zu zertifizierten Entsorgungsbetrieben – ohne Kompromisse.",
    icon: "leaf",
  },
  {
    title: "Bayernweit",
    desc: "Vom Allgäu bis Oberfranken – Logistik aus einer Hand.",
    icon: "map",
  },
];
---

<section id="leistungen" class="relative py-24 lg:py-32 bg-brand-light">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <div class="reveal text-xs font-bold tracking-[0.3em] uppercase text-brand-dark mb-4">
        Leistungen
      </div>
      <h2 class="reveal reveal-delay-1 text-3xl sm:text-4xl lg:text-5xl font-bold text-ink leading-tight">
        Entsorgung gefährlicher und<br/>industrieller Abfälle
      </h2>
      <p class="reveal reveal-delay-2 mt-6 text-lg text-ink-soft leading-relaxed">
        Als zertifizierter Entsorgungsfachbetrieb legen wir größten Wert auf
        Sicherheit, Umweltschutz und gesetzeskonforme Abwicklung – im
        gesamten Einzugsgebiet Bayerns.
      </p>
    </div>

    <div class="mt-14 grid md:grid-cols-3 gap-6">
      {features.map((f, i) => (
        <div class={`reveal reveal-delay-${i + 1} lift bg-white rounded-2xl p-8 border border-black/5`}>
          <div class="w-12 h-12 rounded-xl bg-brand/15 text-brand-dark flex items-center justify-center mb-5">
            {f.icon === "shield" && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            )}
            {f.icon === "leaf" && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21c0-9 6-15 18-15-1 12-7 18-15 18-2 0-3-1-3-3z" stroke-linejoin="round"/><path d="M5 19c4-4 9-8 16-13" stroke-linecap="round"/></svg>
            )}
            {f.icon === "map" && (
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7 7-12a7 7 0 10-14 0c0 5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
            )}
          </div>
          <h3 class="text-xl font-bold text-ink mb-2">{f.title}</h3>
          <p class="text-ink-soft text-sm leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-20">
      <div class="reveal flex items-end justify-between flex-wrap gap-4 mb-8">
        <div>
          <h3 class="text-2xl sm:text-3xl font-bold text-ink mb-2">Abfallarten</h3>
          <p class="text-ink-soft">Unser Transport- und Entsorgungs­spektrum auf einen Blick.</p>
        </div>
        <span class="text-xs font-semibold tracking-widest uppercase text-brand-dark/70">4 Kategorien</span>
      </div>

      <div class="grid sm:grid-cols-2 xl:grid-cols-4 gap-5 lg:gap-6">
        {wasteGroups.map((g, i) => (
          <article class={`reveal reveal-delay-${i + 1} group lift bg-white rounded-2xl p-7 border border-black/5 flex flex-col`}>
            <div class="flex items-center gap-3 mb-5">
              <div class="w-11 h-11 rounded-xl bg-brand/15 text-brand-dark flex items-center justify-center group-hover:bg-brand group-hover:text-ink transition-colors">
                {g.icon === "drop" && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3s-6 7-6 12a6 6 0 0012 0c0-5-6-12-6-12z" stroke-linejoin="round"/></svg>
                )}
                {g.icon === "flask" && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3h6M10 3v6L4 20a2 2 0 001.7 3h12.6A2 2 0 0020 20l-6-11V3" stroke-linejoin="round"/></svg>
                )}
                {g.icon === "factory" && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21V10l6 4V10l6 4V6l6 4v11H3z" stroke-linejoin="round"/><path d="M7 21v-4M12 21v-4M17 21v-4" stroke-linecap="round"/></svg>
                )}
                {g.icon === "box" && (
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7l9-4 9 4v10l-9 4-9-4V7z" stroke-linejoin="round"/><path d="M3 7l9 4 9-4M12 11v10" stroke-linejoin="round"/></svg>
                )}
              </div>
              <h4 class="text-lg font-bold text-ink leading-tight">{g.title}</h4>
            </div>
            <ul class="space-y-2 text-sm text-ink-soft">
              {g.items.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-brand mt-2 shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
