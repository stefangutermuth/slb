---
const items = [
  "Zertifizierter Entsorgungsfachbetrieb",
  "100% Tochter der GSB Bayern",
  "Modernster Spezialfuhrpark",
  "Geschulte Gefahrgut-Fahrer",
  "Bayernweite Abdeckung",
  "Seit über 30 Jahren am Markt",
];
---

<section class="bg-brand-light py-6 overflow-hidden border-y border-brand/10">
  <div class="relative flex">
    <div class="marquee-track flex shrink-0 gap-12 pr-12 items-center">
      {items.concat(items).map((t) => (
        <div class="flex items-center gap-3 text-brand-dark text-sm font-semibold whitespace-nowrap">
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {t}
        </div>
      ))}
    </div>
  </div>
</section>
