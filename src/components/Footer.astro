---
const year = new Date().getFullYear();
const B = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(/\/$/, "");
const root = B.replace(/\/$/, "");
const isHome = path === root || path === "";
const base = isHome ? "" : B;
---

<footer class="bg-ink text-white/80">
  <div class="mx-auto max-w-7xl px-5 lg:px-8 py-16 grid gap-10 md:grid-cols-3">
    <div>
      <img src={`${B}logos/slb-logo-white.svg`} alt="SLB" class="h-12 w-auto mb-5" />
      <p class="text-sm leading-relaxed max-w-xs">
        Umweltschutz beginnt beim sicheren Transport. Spezialist für
        Sonderabfall-Logistik in Bayern.
      </p>
    </div>

    <div>
      <h4 class="text-white text-sm font-semibold tracking-widest uppercase mb-4">
        Kontakt
      </h4>
      <address class="not-italic text-sm leading-relaxed space-y-1">
        <div>SLB – Sonderabfall Logistik Bayern GmbH</div>
        <div>Carl-Benz-Straße 5</div>
        <div>85053 Ingolstadt</div>
        <div class="pt-2">
          <a href="tel:+4984196810" class="hover:text-brand transition-colors">
            +49 (0) 841 / 968 10-0
          </a>
        </div>
        <div>
          <a href="mailto:info@slb-logistik.de" class="hover:text-brand transition-colors">
            info@slb-logistik.de
          </a>
        </div>
      </address>
    </div>

    <div>
      <h4 class="text-white text-sm font-semibold tracking-widest uppercase mb-4">
        Unternehmen
      </h4>
      <ul class="space-y-2 text-sm">
        <li><a href={`${base}#leistungen`} class="hover:text-brand transition-colors">Leistungen</a></li>
        <li><a href={`${base}#fahrzeuge`} class="hover:text-brand transition-colors">Fahrzeuge</a></li>
        <li><a href={`${base}#karriere`} class="hover:text-brand transition-colors">Karriere</a></li>
        <li>
          <a href="https://www.gsb.bayern" target="_blank" rel="noopener" class="hover:text-brand transition-colors inline-flex items-center gap-1">
            Muttergesellschaft GSB
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-5 lg:px-8 py-6 flex flex-col md:flex-row justify-between items-center gap-3 text-xs text-white/50">
      <div>© {year} SLB – Sonderabfall Logistik Bayern GmbH · Keine Cookies, kein Tracking</div>
      <div class="flex gap-5">
        <a href={`${B}impressum`} class="hover:text-brand transition-colors">Impressum</a>
        <a href={`${B}datenschutz`} class="hover:text-brand transition-colors">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
