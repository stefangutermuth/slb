---
const contacts = [
  { name: "Robert Krautschick", role: "Disposition" },
  { name: "Olesja Singer", role: "Disposition" },
  { name: "Alina Lupu", role: "Büro" },
];
const B = import.meta.env.BASE_URL;
---

<section id="kontakt" class="relative py-24 lg:py-32 bg-brand-light">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <div class="reveal text-xs font-bold tracking-[0.3em] uppercase text-brand-dark mb-4">
        Kontakt
      </div>
      <h2 class="reveal reveal-delay-1 text-3xl sm:text-4xl lg:text-5xl font-bold text-ink leading-tight">
        Sprechen Sie mit uns.
      </h2>
      <p class="reveal reveal-delay-2 mt-6 text-lg text-ink-soft leading-relaxed">
        Wir beraten Sie gerne zu Ihrem Sonderabfall-Transport – schnell,
        kompetent und unverbindlich.
      </p>
    </div>

    <div class="mt-14 grid lg:grid-cols-3 gap-6 lg:gap-8">
      <div class="reveal lift bg-white rounded-2xl p-8 border border-black/5">
        <div class="w-12 h-12 rounded-xl bg-brand/15 text-brand-dark flex items-center justify-center mb-5">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke-linejoin="round"/></svg>
        </div>
        <div class="text-xs uppercase tracking-widest text-ink-soft mb-1">Telefon</div>
        <a href="tel:+4984196810" class="text-xl font-bold text-ink hover:text-brand-dark transition-colors">
          +49 (0) 841 / 968 10-0
        </a>
      </div>

      <div class="reveal reveal-delay-1 lift bg-white rounded-2xl p-8 border border-black/5">
        <div class="w-12 h-12 rounded-xl bg-brand/15 text-brand-dark flex items-center justify-center mb-5">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 7l10 7 10-7" stroke-linejoin="round"/></svg>
        </div>
        <div class="text-xs uppercase tracking-widest text-ink-soft mb-1">E-Mail</div>
        <a href="mailto:info@slb-logistik.de" class="text-xl font-bold text-ink hover:text-brand-dark transition-colors break-all">
          info@slb-logistik.de
        </a>
      </div>

      <div class="reveal reveal-delay-2 lift bg-white rounded-2xl p-8 border border-black/5">
        <div class="w-12 h-12 rounded-xl bg-brand/15 text-brand-dark flex items-center justify-center mb-5">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s7-7 7-12a7 7 0 10-14 0c0 5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
        </div>
        <div class="text-xs uppercase tracking-widest text-ink-soft mb-1">Adresse</div>
        <address class="not-italic text-base font-semibold text-ink leading-snug">
          Carl-Benz-Straße 5<br/>85053 Ingolstadt
        </address>
      </div>
    </div>

    <div class="mt-16 grid lg:grid-cols-5 gap-8">
      <div class="lg:col-span-2 reveal">
        <h3 class="text-2xl font-bold text-ink mb-6">Ansprechpartner</h3>
        <div class="space-y-3">
          {contacts.map((c, i) => (
            <div class={`reveal reveal-delay-${i + 1} flex items-center gap-4 bg-white rounded-2xl p-5 border border-black/5`}>
              <div class="w-12 h-12 rounded-full bg-brand text-ink flex items-center justify-center font-bold text-lg shrink-0">
                {c.name.split(" ").map((p) => p[0]).join("")}
              </div>
              <div>
                <div class="font-bold text-ink">{c.name}</div>
                <div class="text-sm text-ink-soft">{c.role}</div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-3 reveal reveal-delay-2">
        <div
          id="map-wrap"
          class="relative rounded-3xl overflow-hidden shadow-xl border border-black/5 h-full min-h-[360px] bg-ink"
          data-map-src="https://www.openstreetmap.org/export/embed.html?bbox=11.4490%2C48.7480%2C11.4690%2C48.7620&layer=mapnik&marker=48.7550%2C11.4590"
        >
          <div class="absolute inset-0 opacity-[0.08] pointer-events-none">
            <img src={`${B}images/slb-30.jpg`} alt="" class="w-full h-full object-cover" />
          </div>
          <div class="absolute inset-0 flex items-center justify-center p-6 text-center text-white">
            <div class="max-w-sm">
              <div class="inline-flex w-14 h-14 rounded-2xl bg-brand text-ink items-center justify-center mb-5">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s7-7 7-12a7 7 0 10-14 0c0 5 7 12 7 12z"/>
                  <circle cx="12" cy="10" r="2.5"/>
                </svg>
              </div>
              <h4 class="text-xl font-bold mb-2">Karte aktivieren</h4>
              <p class="text-sm text-white/75 leading-relaxed mb-5">
                Mit dem Klick auf „Karte laden" wird eine Verbindung zu
                OpenStreetMap aufgebaut. Dabei werden Daten (u. a. Ihre
                IP-Adresse) an die OSM-Foundation übermittelt. Details in
                unserer
                <a href={`${B}datenschutz`} class="underline hover:text-brand">Datenschutzerklärung</a>.
              </p>
              <button
                type="button"
                id="map-load"
                class="inline-flex items-center gap-2 rounded-full bg-brand px-6 py-3 text-sm font-bold text-ink hover:bg-white transition-colors"
              >
                Karte laden
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <a
                href="https://www.openstreetmap.org/?mlat=48.7550&mlon=11.4590#map=16/48.7550/11.4590"
                target="_blank"
                rel="noopener"
                class="block mt-4 text-xs text-white/50 hover:text-brand transition-colors"
              >
                Alternativ in OpenStreetMap öffnen ↗
              </a>
            </div>
          </div>
        </div>
      </div>

      <script is:inline>
        (function () {
          const wrap = document.getElementById("map-wrap");
          const btn = document.getElementById("map-load");
          if (!wrap || !btn) return;
          btn.addEventListener("click", () => {
            const src = wrap.getAttribute("data-map-src");
            wrap.innerHTML =
              '<iframe title="Standort SLB Ingolstadt" src="' +
              src +
              '" class="w-full h-full" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>';
          });
        })();
      </script>
    </div>
  </div>
</section>
